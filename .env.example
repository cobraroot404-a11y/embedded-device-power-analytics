# Copy this file to .env and adjust values for local development.
# .env is git-ignored and must never be committed.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry_dev_password
POSTGRES_DB=embedded_telemetry
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://telemetry:telemetry_dev_password@timescaledb:5432/embedded_telemetry

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_FILTER=devices/+/telemetry

# --- Analytics thresholds ---
GAP_THRESHOLD_MINUTES=30
RARELY_USED_ON_PERCENT=10
EXCESSIVE_ON_HOURS=8
POOR_POWER_SAVING_PERCENT=20
LOW_BATTERY_PERCENT=20
ABNORMAL_POWER_MULTIPLIER=2.5

# --- Consumer metrics HTTP server ---
CONSUMER_HOST=telemetry-consumer
CONSUMER_METRICS_PORT=9100

# --- Other services, used by GET /system/health ---
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
FRONTEND_HEALTH_URL=http://frontend:80

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend (build-time; only used if not proxied through nginx) ---
# Leave unset in Docker Compose — the frontend calls same-origin "/api",
# proxied by nginx to the api service. Only needed for `npm run dev` against
# a bare API on a different origin, e.g. VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
